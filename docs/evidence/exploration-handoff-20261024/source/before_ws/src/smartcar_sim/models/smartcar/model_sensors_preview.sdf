    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="left_caster_swivel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_caster_swivel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.0005</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="left_caster_roll_joint" type="revolute">
      <parent>left_caster_swivel</parent>
      <child>left_caster_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="right_caster_swivel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_caster_swivel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.0005</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="right_caster_roll_joint" type="revolute">
      <parent>right_caster_swivel</parent>
      <child>right_caster_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>5</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="lidar_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.252</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <topic>/model/smartcar/cmd_vel</topic>
      <odom_topic>/model/smartcar/odometry</odom_topic>
      <tf_topic>/model/smartcar/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.3</max_linear_velocity>
      <min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/model/smartcar/joint_states</topic>
    </plugin>
  </model>
