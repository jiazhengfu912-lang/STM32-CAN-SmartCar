  "formal_pairs": [
    [
      "before_v15_discovery",
      "final_v16_discovery"
    ],
    [
      "before_v15_office",
      "final_v16_office"
    ]
  ],
  "max_sim_seconds": 900,
  "scope": "Serial independent Gazebo runs; same world, SLAM, NavFn/RPP, speed, clearance, goal tolerance and protection; no hardware",
  "primary_metrics": [
    "known-area throughput at matched 90->95 and 95->98 percent coverage",
    "near-stationary simulation seconds at the same intervals",
    "goal-result to next-goal handoff delays"
  ],
  "secondary_metrics": [
    "stop/start episodes >=0.5 simulation seconds",
    "task trajectory length",
    "final known/free coverage and exported map geometry",
    "input freshness and watchdog recovery"
  ],
  "interpretation": "Goal count alone is not useful work; partial/failed runs remain partial/failed; existing v14 runs only historical context; one pair per scene is not statistical significance",
  "execution_notes": [
    "Build and full software tests overlapped the early first office baseline. One targeted ~0.7 s map-refresh check ran during the early lab baseline. Simulations are serial; later full test suites and plotting are held until motion experiments finish. Single-pair engineering observations are not a resource-controlled statistical performance claim.",
    "Analysis plots and final full software checks run after motion experiments.",
